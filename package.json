{
  "name": "contract-trap-spotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that flags risky clauses in terms of service and privacy policies",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "eval": "tsx --env-file=.env eval/run.ts",
    "cy:run": "cypress run --browser chrome"
  },
  "dependencies": {
    "@page-agent/page-controller": "^1.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
